# Copy to .env for local development. Do not commit real secrets.

# Optional: override the GitHub repository that README links point to.
# GITHUB_REPOSITORY=nehaabalaji/Supply-Chain-Internships

# Optional: token used only if you run GitHub API helpers locally.
# GitHub Actions already provides GITHUB_TOKEN automatically — no secret is required
# for the scheduled update workflow.
# GITHUB_TOKEN=

# Optional: HTTP cache directory for local scraper development.
# CACHE_DIR=.cache

# Optional: maximum jobs shown per category in README.md
# MAX_README_JOBS_PER_CATEGORY=200

# Set to 1 to skip live HTTP during tests (tests already use fixtures).
# SCI_OFFLINE=0
