{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nehaabalaji/Supply-Chain-Internships/data/schema.json",
  "title": "InternshipJob",
  "type": "object",
  "required": [
    "id",
    "company",
    "title",
    "location",
    "category",
    "job_type",
    "application_url",
    "source"
  ],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "company": { "type": "string", "minLength": 1 },
    "company_logo": { "type": "string" },
    "title": { "type": "string", "minLength": 2 },
    "normalized_title": { "type": "string" },
    "location": { "type": "string", "minLength": 1 },
    "city": { "type": ["string", "null"] },
    "state": { "type": ["string", "null"] },
    "country": { "type": ["string", "null"] },
    "category": {
      "type": "string",
      "enum": [
        "Supply Chain",
        "Operations",
        "Product Management",
        "Procurement & Sourcing",
        "Logistics",
        "Business Analytics",
        "Project & Program Management",
        "Manufacturing",
        "Other"
      ]
    },
    "subcategory": { "type": ["string", "null"] },
    "category_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "job_type": {
      "type": "string",
      "enum": [
        "Internship",
        "Co-op",
        "Summer Internship",
        "Fall Internship",
        "Spring Internship",
        "Part-time Internship",
        "Full-time Internship",
        "New Graduate",
        "Entry Level",
        "Unknown"
      ]
    },
    "work_arrangement": {
      "type": "string",
      "enum": ["Remote", "Hybrid", "On-site", "Unknown"]
    },
    "date_posted": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "date_discovered": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "application_url": { "type": "string", "minLength": 8 },
    "source_url": { "type": "string" },
    "source": { "type": "string", "minLength": 1 },
    "source_key": { "type": "string" },
    "source_job_id": { "type": ["string", "null"] },
    "description": { "type": "string" },
    "salary_min": { "type": ["number", "null"] },
    "salary_max": { "type": ["number", "null"] },
    "salary_currency": { "type": ["string", "null"] },
    "sponsorship": { "type": "string", "enum": ["Yes", "No", "Unknown"] },
    "active": { "type": "boolean" },
    "last_verified": { "type": "string" },
    "needs_review": { "type": "boolean" },
    "consecutive_misses": { "type": "integer", "minimum": 0 },
    "seed": { "type": "boolean" }
  }
}
